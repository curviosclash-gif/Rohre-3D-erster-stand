        "domain": "graph-rag",
        "tooling": "read-only-evidence-query"
      }
    },
    {
      "id": "runtime:graph-rag-context-adapter",
      "type": "runtime",
      "title": "Graph-RAG optional context adapter",
      "file": "scripts/graph-rag-context-adapter.mjs",
