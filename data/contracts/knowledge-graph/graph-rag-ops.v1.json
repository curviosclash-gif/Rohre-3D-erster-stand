{
  "contract": "knowledge-graph.mapping.v1",
  "schema_version": 1,
  "mapping_id": "graph-rag-ops",
  "description": "Read-only Graph-RAG ops layer for transient indexing, source-backed retrieval and optional local context adaptation.",
