      "attributes": {
        "domain": "graph-rag",
        "tooling": "read-only-context-index"
      }
    },
    {
      "id": "runtime:graph-rag-query",
      "type": "runtime",
      "title": "Graph-RAG source-backed query",
      "file": "scripts/graph-rag-query.mjs",
