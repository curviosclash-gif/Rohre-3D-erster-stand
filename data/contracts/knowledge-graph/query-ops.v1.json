  "playbooks": [
    {
      "id": "critical-path-health",
      "link": "data/contracts/knowledge-graph/query-ops.v1.json#playbook:critical-path-health",
      "trigger_codes": [
        "KG_QUERY_SLO_MISSING",
        "KG_QUERY_SLO_BUDGET_MISSING",
        "KG_QUERY_SLO_GATE_INVALID",
        "KG_CRITICAL_NODE_MISSING",
        "KG_CRITICAL_EDGE_MISSING",
        "KG_RUNTIME_VALIDATION_MISSING"
      ],
      "triage_queries": [
        "node scripts/query-knowledge-graph.mjs critical-path-health --json",
        "node scripts/query-knowledge-graph.mjs event-flow spawn --json",
        "node scripts/query-knowledge-graph.mjs event-flow combat-hit --json",
        "node scripts/query-knowledge-graph.mjs event-flow round-end --json",
        "node scripts/query-knowledge-graph.mjs untested-systems --json"
      ],
      "recovery_steps": [
        "Identify missing layer, validation edge or runtime node from critical-path-health output.",
        "Repair the productive mapping contract in data/contracts/knowledge-graph before changing generated artifacts.",
        "Run npm run graph:build, npm run graph:check and npm run graph:slo after the mapping repair."
      ],
      "exit_criteria": [
        "critical-path-health reports status=ok for spawn, combat-hit, round-end and settings.",
        "npm run graph:slo passes for the active profile.",
        "No KG_CRITICAL_* or KG_RUNTIME_VALIDATION_MISSING violation remains."
      ]
    },
    {
      "id": "change-risk",
      "link": "data/contracts/knowledge-graph/query-ops.v1.json#playbook:change-risk",
      "trigger_codes": [
        "KG_QUERY_PLAYBOOK_MISSING",
        "KG_QUERY_PLAYBOOK_INVALID",
        "KG_QUERY_SLO_MISSING",
        "KG_QUERY_SLO_BUDGET_MISSING"
      ],
      "triage_queries": [
        "node scripts/query-knowledge-graph.mjs change-risk --json",
        "node scripts/query-knowledge-graph.mjs impact-for-file src/core/SettingsManager.js --json",
        "node scripts/query-knowledge-graph.mjs critical-path-health --json"
      ],
      "recovery_steps": [
        "Review riskFiles and criticalPaths from change-risk before choosing follow-up checks.",
        "For every reported critical path, run the recommended event-flow query and compare relation edges.",
        "If risk is unexpected, repair coverage or mapping provenance, then rerun graph:build, graph:check and graph:slo."
      ],
      "exit_criteria": [
        "change-risk returns the expected riskStatus for the changed file set.",
        "Recommended checks include graph:build and graph:check plus event-flow checks for affected critical paths.",
        "The SLO gate remains green for change-risk."
      ]
    },
    {
      "id": "export-view-safety",
      "link": "data/contracts/knowledge-graph/query-ops.v1.json#playbook:export-view-safety",
      "trigger_codes": [
        "KG_EXPORT_SAFETY_REDACTION_MISSING",
        "KG_QUERY_PLAYBOOK_INVALID"
      ],
      "triage_queries": [
        "node scripts/query-knowledge-graph.mjs export-view --json",
        "node scripts/query-knowledge-graph.mjs export-view --unsafe-raw --json"
      ],
      "recovery_steps": [
        "Use export-view without --unsafe-raw for committed evidence, viewer handoff or shared local reports.",
        "Use --unsafe-raw only for local incident audit when the caller must inspect original graph attributes.",
        "If raw export was produced, keep it out of commits and rerun the default export-view before documenting evidence."
      ],
      "exit_criteria": [
        "Default export-view reports safety.mode=default-redacted.",
        "PII and secret-like keys or values are replaced with redaction markers.",
        "Raw output is available only through the explicit --unsafe-raw override."
      ]
    },
    {
      "id": "quality-scorecard",
      "link": "data/contracts/knowledge-graph/query-ops.v1.json#playbook:quality-scorecard",
      "trigger_codes": [
        "SCORECARD_DIFF",
        "KG_QUERY_PLAYBOOK_INVALID"
      ],
      "triage_queries": [
        "node scripts/query-knowledge-graph.mjs quality-scorecard --json",
        "npm run graph:build",
        "npm run graph:check"
      ],
      "recovery_steps": [
        "Inspect scorecard current.metrics and trend before changing generated artifacts.",
        "If the score regressed, compare criticalPaths and coverage gate output to identify the affected graph layer.",
        "Repair mapping or coverage sources, then rerun graph:build and graph:check."
      ],
      "exit_criteria": [
        "quality-scorecard reports a pass status or a documented review reason.",
        "knowledge-graph.scorecard.json is byte-identical to graph:build output.",
        "Trend direction and scoreDelta are reproducible from committed history."
      ]
    },
    {
      "id": "counterfactual-analysis",
      "link": "data/contracts/knowledge-graph/query-ops.v1.json#playbook:counterfactual-analysis",
      "trigger_codes": [
        "KG_QUERY_PLAYBOOK_INVALID"
      ],
      "triage_queries": [
        "node scripts/query-knowledge-graph.mjs what-if-remove src/core/SettingsManager.js --json",
        "node scripts/query-knowledge-graph.mjs what-if-replace src/core/SettingsManager.js tests/runtime-settings-live-apply.contract.test.mjs --json"
      ],
      "recovery_steps": [
        "Review blastRadius, predictedEffects and uncertaintyBudget before accepting a removal or replacement.",
        "Run every recommended event-flow query for affected critical paths.",
        "Treat medium or high uncertainty as human-review evidence, not an automatic approval."
      ],
      "exit_criteria": [
        "Counterfactual output includes blastRadius, recommendedChecks and uncertaintyBudget.",
        "Affected critical paths are explicit and reproducible for the reference Settings case.",
        "No removal proceeds without replacement evidence for validation or guardrail edges."
      ]
    },
    {
      "id": "adaptive-diagnostics",
      "link": "data/contracts/knowledge-graph/query-ops.v1.json#playbook:adaptive-diagnostics",
      "trigger_codes": [
        "KG_QUERY_PLAYBOOK_INVALID",
        "KG_SCHEMA_CONTRACT_MISMATCH",
        "KG_SCHEMA_EDGE_ENDPOINT_MISSING",
        "SCORECARD_DIFF"
      ],
      "triage_queries": [
        "node scripts/query-knowledge-graph.mjs incident-auto-minimize src/core/SettingsManager.js --json",
        "node scripts/query-knowledge-graph.mjs temporal-anomalies --json",
        "node scripts/query-knowledge-graph.mjs schema-lint --json"
      ],
      "recovery_steps": [
        "Use incident-auto-minimize to reduce changed files to the smallest critical-path evidence set.",
        "Use temporal-anomalies before accepting scorecard drift after a graph contract or mapping change.",
        "Use schema-lint as the fast shape check before graph:check when schema drift is suspected."
      ],
      "exit_criteria": [
        "Auto-minimization names reproducible candidate files, root evidence and checks for the incident slice.",
        "Temporal anomaly output is ok/watch with any review signal documented before merge.",
        "Schema-lint reports status=pass before generated artifacts are treated as stable."
      ]
    },
    {
      "id": "adaptive-quality-control",
      "link": "data/contracts/knowledge-graph/query-ops.v1.json#playbook:adaptive-quality-control",
      "trigger_codes": [
        "KG_QUERY_PLAYBOOK_INVALID",
        "KG_TEST_PRIORITY_MISSING",
        "KG_POLICY_REVIEW_REQUIRED"
      ],
      "triage_queries": [
        "node scripts/query-knowledge-graph.mjs test-prioritization src/core/SettingsManager.js --json",
        "node scripts/query-knowledge-graph.mjs policy-evaluate --json",
        "node scripts/query-knowledge-graph.mjs feedback-loop src/core/SettingsManager.js --json"
      ],
      "recovery_steps": [
        "Use test-prioritization to select the smallest graph-backed contract-test set for changed critical paths.",
        "Use policy-evaluate to check scorecard, schema and temporal guardrails before accepting adaptive query output.",
        "Treat feedback-loop adjustments as human-reviewed recommendations; do not auto-write preset or policy changes from noisy signals."
      ],
      "exit_criteria": [
        "Prioritized tests include concrete node --test commands for each affected critical path.",
        "Policy evaluation reports pass or a documented review reason.",
        "Feedback recommendations name accepted signal types and guardrails before changing query presets."
      ]
    }
